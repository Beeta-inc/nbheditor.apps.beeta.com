<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#000000"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✦ Beeta AI"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/accent_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/newChatBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="New"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:icon="@drawable/ic_new_file"
                app:iconSize="16dp"
                app:iconPadding="4dp"
                app:backgroundTint="@color/accent_primary"
                app:cornerRadius="18dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                style="@style/Widget.MaterialComponents.Button" />

            <TextView
                android:id="@+id/historyBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕐"
                android:textSize="18sp"
                android:padding="8dp"
                android:textColor="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/clearChatBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:textSize="11sp"
                android:textColor="#9AA0A6"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/aiStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="● Online"
                android:textSize="10sp"
                android:textColor="@color/accent_secondary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/webSearchChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🌐 Web"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#141414"
                app:chipStrokeColor="#3C4043"
                app:chipStrokeWidth="1.5dp"
                android:checkable="true"
                android:checked="false"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="32dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/imageGenChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🖼 Image"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#141414"
                app:chipStrokeColor="#3C4043"
                app:chipStrokeWidth="1.5dp"
                android:checkable="true"
                android:checked="false"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="32dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/videoAnalysisChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🎥 Video"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#141414"
                app:chipStrokeColor="#3C4043"
                app:chipStrokeWidth="1.5dp"
                android:checkable="true"
                android:checked="false"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="32dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#3C4043"
        app:layout_constraintTop_toBottomOf="@id/chatHeader" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        android:padding="32dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toTopOf="@id/typingRow">

        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <View
                android:id="@+id/ai_empty_state"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#1A1A1A"
                app:strokeWidth="1dp"
                app:strokeColor="#3C4043">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="✦"
                    android:textSize="64sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ask Beeta AI anything"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="#FFFFFF"
                android:paddingTop="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code · Writing · Images · Voice"
                android:textSize="14sp"
                android:textColor="#9AA0A6"
                android:paddingTop="8dp" />

            <!-- Quick Action Chips (Nir Eyal 1-Tap Trigger aligned with Web) -->
            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickSummarizeChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Summarize Notes"
                    android:textSize="12sp"
                    android:textColor="#38BDF8"
                    app:chipBackgroundColor="#141414"
                    app:chipStrokeColor="#3C4043"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickBrainstormChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Brainstorm Ideas"
                    android:textSize="12sp"
                    android:textColor="#FBBF24"
                    app:chipBackgroundColor="#141414"
                    app:chipStrokeColor="#3C4043"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickChecklistChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☑️ Action Checklist"
                    android:textSize="12sp"
                    android:textColor="#34D399"
                    app:chipBackgroundColor="#141414"
                    app:chipStrokeColor="#3C4043"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickCodeChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 Help with code"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:chipBackgroundColor="#141414"
                    app:chipStrokeColor="#3C4043"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickExplainChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 Explain concept"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:chipBackgroundColor="#141414"
                    app:chipStrokeColor="#3C4043"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/quickDebugChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐛 Debug issue"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:chipBackgroundColor="#141414"
                    app:chipStrokeColor="#3C4043"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Action" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:visibility="gone"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toTopOf="@id/voiceStatusIndicator" />

    <!-- Voice Status Indicator -->
    <LinearLayout
        android:id="@+id/voiceStatusIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="#1A1A1A"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/typingRow">

        <TextView
            android:id="@+id/voiceStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Voice mode active - no speech detected"
            android:textSize="13sp"
            android:textColor="#FFFFFF" />

        <com.beeta.nbheditor.VoiceEqualizerView
            android:id="@+id/voiceEqualizer"
            android:layout_width="60dp"
            android:layout_height="28dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Typing indicator -->
    <LinearLayout
        android:id="@+id/typingRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="#000000"
        app:layout_constraintBottom_toTopOf="@id/inputDivider">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/accent_primary" />

        <TextView
            android:id="@+id/typingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beeta AI is thinking..."
            android:textSize="12sp"
            android:textColor="#9AA0A6"
            android:paddingStart="8dp" />
    </LinearLayout>

    <View
        android:id="@+id/inputDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#3C4043"
        app:layout_constraintBottom_toTopOf="@id/inputBar" />

    <!-- Input bar -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/voiceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_mic"
            app:backgroundTint="#1A1A1A"
            app:tint="#FFFFFF"
            app:fabSize="normal"
            app:elevation="2dp"
            android:contentDescription="Voice input"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#3C4043">

            <EditText
                android:id="@+id/queryEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Message Beeta AI..."
                android:textColorHint="#9AA0A6"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:scrollbars="vertical"
                android:background="@null"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_send"
            app:backgroundTint="#FFFFFF"
            app:tint="#000000"
            app:fabSize="normal"
            app:elevation="2dp"
            android:contentDescription="Send" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
