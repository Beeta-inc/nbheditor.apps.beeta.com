<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:backgroundTint="#000000"
    app:cardBackgroundColor="#000000"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#3C4043"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/cbTodo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFF"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTodoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Todo Title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTodoDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today, 5:00 PM"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_suggestion_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🔔 Reminder"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTodoOptions"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Todo Options"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#9AA0A6" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
